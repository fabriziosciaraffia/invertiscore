{
  "name": "franco-reels",
  "version": "1.0.0",
  "private": true,
  "description": "Reels de refranco.ai en Remotion. Proyecto aislado del app Next.",
  "scripts": {
    "dev": "remotion studio",
    "render": "remotion render BarRacePlusvalia out/reel-plusvalia.mp4",
    "still": "remotion still BarRacePlusvalia out/frame.png",
    "render:lineas": "remotion render LineasTop5 out/reel-lineas-top5.mp4",
    "still:lineas": "remotion still LineasTop5 out/lineas-final.png --frame=719",
    "render:portada": "remotion still PortadaLineas out/portada-reel.png"
  },
  "dependencies": {
    "@remotion/cli": "^4.0.0",
    "@remotion/google-fonts": "^4.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "remotion": "^4.0.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "typescript": "^5.6.3"
  }
}
