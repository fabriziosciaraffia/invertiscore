# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.js
.yarn/install-state.gz

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files
.env
.env*.local

# PowerShell scripts (contienen secrets locales)
*.ps1

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

.vercel

.env*.local

# playwright
/test-results/
/playwright-report/
/playwright/.cache/
ms-playwright/
.playwright-mcp/

# auth cookies y secrets locales de sesión
.auth-cookies*.json
.cookies-*
.prod-cookies-*
.set-*cookies*
*.local.json
# Volcados de sesión de navegador en la raíz. `.evaluate-fn.txt` era el cuerpo
# de un document.cookie con un access_token de Supabase en texto plano, y los
# patrones de arriba no lo tapaban: no decía "cookie" en el nombre. Estos
# cubren la familia que lo generó y los nombres con pinta de token.
# OJO: el .gitignore evita commitearlos, NO evita que existan en disco. Un
# archivo así se borra, no se ignora.
.evaluate-*
*auth-token*
.token-*
.session-*

# config local MCP (servidores externos)
.mcp.json

# claude runtime
.claude/scheduled_tasks.lock

# screenshots de sesión (audit / iteración visual)
audit-*.png
f*-*.png
e*-*.png
commit*-*.png
prod-*.png
hero-*.png
landing-*.png

# screenshots dev en root (no afecta public/ ni src/)
/*.png
/*.jpg
phase*.png
phase*.jpg
step*-*.png
cards-ds-*.png
caso*-*.png

# EXCEPCIÓN: los patrones de screenshots de arriba no llevan slash inicial, así
# que matchean a cualquier profundidad. `f*-*.png` se comía 24 de los 31
# wordmarks de marca (franco-wordmark-*.png) sin que nadie lo notara: eran
# untracked "por diseño" en apariencia y en realidad estaban tapados. Los
# entregables de marca se versionan enteros.
!docs/brand-assets/**

# scripts y docs dev locales
scripts/dev-*
scripts/audit-*
scripts/find-*
scripts/probe-*
docs/audit-*.md
# scripts/auth-*: fabrican cookies de sesión de Supabase para QA. Son útiles y
# se reusan, pero generan credenciales — se quedan locales por decisión, nunca
# en el repo.
scripts/auth-*

# artefactos locales
outputs/
supabase/seeds/
supabase/.temp/

# Salidas de corrida del evaluador editorial. El instrumento (RUBRICA.md, juez,
# ensamblador, censo) SÍ se versiona: es la fuente de verdad y se edita a mano.
# Lo que sale de cada corrida —informes ensamblados, JSON de fallas, logs— es
# regenerable y pesa megas (2,7 MB en una sola sesión). El patrón cubre out/,
# out-censo/, out-cierre2/, out-mockup2/… y sus .log hermanos.
scripts/eval/editorial/out*/
scripts/eval/editorial/out*.log

# dumps de auditoría
audit/
# reportes de auditoría read-only versionados (docs/audit/AAAA-MM-DD-*.md)
!docs/audit/
# scripts de auditoría versionados (read-only, se corren a mano)
!scripts/audit/
.env.local

# ── Artefactos de agente ────────────────────────────────────────────────────
# Los goals dejan prompts, reportes, snapshots y scripts de QA en la raíz y en
# scripts/. Eran ~300 archivos untracked: git status quedaba ilegible y el
# staging selectivo se volvía un campo minado.
of-*.md
of-*.ts
of-*.mjs
scripts/of-*
snap-*.md
prod-snap-*.md
scripts/output/
tmp/
*.patch

# EXCEPCIONES: estos cuatro of-* SÍ están versionados (calibración de AMBAS y su
# POC). Un .gitignore no des-trackea lo ya trackeado, pero sin estas negaciones
# quedaban invisibles para `git add` si alguna vez se recrean — y el patrón que
# los tapa es el mismo que limpia los 182 scripts de agente. Se salvan por
# nombre en vez de sacrificar el patrón entero.
!scripts/of-ambas-calib-*
!scripts/of-calib-poc.ts
# Proyecto Remotion de los reels (tools/reels): dependencias, renders y los
# prototipos HTML de referencia. El código del reel y su dataset SÍ se versionan;
# lo pesado y lo ajeno, no.
tools/**/node_modules
tools/reels/out/
tools/reels/ref/
*.mp4
